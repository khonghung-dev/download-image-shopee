#define MyAppName "Shopee Image Downloader"
#define MyAppVersion "0.1.0"
#define MyAppExeName "ShopeeImageDownloader.exe"
#define MyHostName "com.shopee_image_downloader.bridge"

[Setup]
AppId={{119CCD27-4A4F-4083-B6C1-ABAA41D31978}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher=Shopee Image Downloader Team
VersionInfoVersion=0.1.0.0
DefaultDirName={localappdata}\Programs\ShopeeImageDownloader
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
OutputDir=..\release\installer
OutputBaseFilename=ShopeeImageDownloader-Setup-{#MyAppVersion}
Compression=lzma2/max
SolidCompression=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
CloseApplications=yes
RestartApplications=no
MinVersion=10.0
WizardStyle=modern
SetupLogging=yes

; English is guaranteed by Inno Setup. The installed guide remains Vietnamese.
[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Tạo biểu tượng ngoài Desktop"; GroupDescription: "Tùy chọn bổ sung:"; Flags: checkedonce

[Files]
; Keep the approved Task 016 ONEDIR payload unchanged except for two install-time files:
; - the Native Messaging manifest must be generated with the actual install path;
; - the installed release needs installer-specific first-run instructions.
Source: "..\release\ShopeeImageDownloader-Windows\*"; DestDir: "{app}"; Excludes: "README_FIRST.txt,native_host\{#MyHostName}.json"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "README_INSTALLER.txt"; DestDir: "{app}"; DestName: "README_FIRST.txt"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{autoprograms}\Hướng dẫn cài Chrome Extension"; Filename: "{sys}\notepad.exe"; Parameters: """{app}\README_FIRST.txt"""; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Chạy Shopee Image Downloader"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent
Filename: "{sys}\notepad.exe"; Parameters: """{app}\README_FIRST.txt"""; Description: "Mở hướng dẫn cài Chrome Extension"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; This is the one manifest generated by install_native_host.ps1 after files are copied.
Type: files; Name: "{app}\native_host\{#MyHostName}.json"

[Code]
function RunPackagedPowerShellScript(
  const ScriptName: String;
  const ActionDescription: String
): Boolean;
var
  PowerShellPath: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := False;
  PowerShellPath := ExpandConstant(
    '{sys}\WindowsPowerShell\v1.0\powershell.exe'
  );
  Parameters := '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' +
    AddQuotes(ExpandConstant('{app}\' + ScriptName));

  Log(ActionDescription + ': ' + PowerShellPath + ' ' + Parameters);
  if not Exec(
    PowerShellPath,
    Parameters,
    ExpandConstant('{app}'),
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  ) then
  begin
    MsgBox(
      ActionDescription + ' không thể khởi chạy PowerShell.',
      mbError,
      MB_OK
    );
    exit;
  end;

  if ResultCode <> 0 then
  begin
    MsgBox(
      ActionDescription + ' thất bại (mã lỗi ' + IntToStr(ResultCode) + ').',
      mbError,
      MB_OK
    );
    exit;
  end;

  Result := True;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    if not RunPackagedPowerShellScript(
      'install_native_host.ps1',
      'Đăng ký Native Host cho người dùng hiện tại'
    ) then
    begin
      RaiseException(
        'Không thể hoàn tất cài đặt vì Native Host chưa được đăng ký.'
      );
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    if not RunPackagedPowerShellScript(
      'uninstall_native_host.ps1',
      'Gỡ đăng ký Native Host của người dùng hiện tại'
    ) then
    begin
      RaiseException(
        'Không thể tiếp tục gỡ cài đặt vì đăng ký Native Host chưa được xóa.'
      );
    end;
  end;
end;
