{
  "manifest_version": 3,
  "name": "Shopee Product Extractor",
  "version": "1.0.0",
  "key": "",
  "description": "Extract Shopee product details and relay batch or manual results to Shopee Image Downloader.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "*://*.shopee.vn/*",
    "*://*.shopee.sg/*",
    "*://*.shopee.co.id/*",
    "*://*.shopee.co.th/*",
    "*://*.shopee.ph/*",
    "*://*.shopee.my/*",
    "*://*.shopee.com.br/*",
    "*://*.shopee.tw/*",
    "*://*.shopee.com/*",
    "*://*.s.shopee.vn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Product Extractor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.shopee.vn/*",
        "*://*.shopee.sg/*",
        "*://*.shopee.co.id/*",
        "*://*.shopee.co.th/*",
        "*://*.shopee.ph/*",
        "*://*.shopee.my/*",
        "*://*.shopee.com.br/*",
        "*://*.shopee.tw/*",
        "*://*.shopee.com/*",
        "*://*.s.shopee.vn/*"
      ],
      "js": [
        "extractor_core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
